<Project Sdk="Microsoft.NET.Sdk">

	<!--
		Binds FaceLivenessBridge.framework — the Objective-C face of the native iOS liveness
		screens, built from Face-LivenessDetection-iOS with `scripts/build_bridge.sh`.

		This is a separate project because .NET only accepts ObjcBindingApiDefinition in a binding
		project, not in an app. The app references it for net8.0-ios only.
	-->
	<PropertyGroup>
		<TargetFramework>net8.0-ios</TargetFramework>
		<SupportedOSPlatformVersion>15.0</SupportedOSPlatformVersion>
		<RootNamespace>FaceLivenessBridge</RootNamespace>
		<Nullable>disable</Nullable>
		<ImplicitUsings>true</ImplicitUsings>
		<IsBindingProject>true</IsBindingProject>
		<!--
			Ship the binding as a plain assembly rather than embedding the frameworks inside it:
			the engine alone is tens of megabytes, and the app links them anyway.
		-->
		<NoBindingEmbedding>true</NoBindingEmbedding>
		<AllowUnsafeBlocks>true</AllowUnsafeBlocks>
	</PropertyGroup>

	<ItemGroup>
		<ObjcBindingApiDefinition Include="ApiDefinition.cs" />
		<ObjcBindingCoreSource Include="StructsAndEnums.cs" />
	</ItemGroup>

	<!--
		Device ios-arm64 *.framework slices (Recognition MAUI pattern). fp_releases.py extracts
		xcframeworks from runtime.zip / bridge.zip then slices them here. Referencing flat
		frameworks avoids XCFramework extract races that leave codesign looking at missing paths.
		Each is Exists()-gated so a clean checkout still restores; the app's CheckIosRuntime fails
		with a named message listing whichever are missing.
	-->
	<ItemGroup>
		<NativeReference Include="..\FaceLiveness.Net.Maui\Platforms\iOS\Frameworks\FaceLivenessBridge.framework"
		                 Condition="Exists('..\FaceLiveness.Net.Maui\Platforms\iOS\Frameworks\FaceLivenessBridge.framework')">
			<Kind>Framework</Kind>
			<SmartLink>False</SmartLink>
			<ForceLoad>True</ForceLoad>
		</NativeReference>
		<NativeReference Include="..\FaceLiveness.Net.Maui\Platforms\iOS\Frameworks\FaceLivenessKit.framework"
		                 Condition="Exists('..\FaceLiveness.Net.Maui\Platforms\iOS\Frameworks\FaceLivenessKit.framework')">
			<Kind>Framework</Kind>
			<SmartLink>False</SmartLink>
			<ForceLoad>True</ForceLoad>
		</NativeReference>
		<NativeReference Include="..\FaceLiveness.Net.Maui\Platforms\iOS\Frameworks\facerecognitionsdk.framework"
		                 Condition="Exists('..\FaceLiveness.Net.Maui\Platforms\iOS\Frameworks\facerecognitionsdk.framework')">
			<Kind>Framework</Kind>
			<SmartLink>False</SmartLink>
			<ForceLoad>True</ForceLoad>
		</NativeReference>
		<NativeReference Include="..\FaceLiveness.Net.Maui\Platforms\iOS\Frameworks\FacePluginSDK.framework"
		                 Condition="Exists('..\FaceLiveness.Net.Maui\Platforms\iOS\Frameworks\FacePluginSDK.framework')">
			<Kind>Framework</Kind>
			<SmartLink>False</SmartLink>
			<ForceLoad>True</ForceLoad>
		</NativeReference>
		<NativeReference Include="..\FaceLiveness.Net.Maui\Platforms\iOS\Frameworks\FacePPlugin.framework"
		                 Condition="Exists('..\FaceLiveness.Net.Maui\Platforms\iOS\Frameworks\FacePPlugin.framework')">
			<Kind>Framework</Kind>
			<SmartLink>False</SmartLink>
			<ForceLoad>True</ForceLoad>
		</NativeReference>
		<NativeReference Include="..\FaceLiveness.Net.Maui\Platforms\iOS\Frameworks\FaceDetect.framework"
		                 Condition="Exists('..\FaceLiveness.Net.Maui\Platforms\iOS\Frameworks\FaceDetect.framework')">
			<Kind>Framework</Kind>
			<SmartLink>False</SmartLink>
			<ForceLoad>True</ForceLoad>
		</NativeReference>
	</ItemGroup>

</Project>
